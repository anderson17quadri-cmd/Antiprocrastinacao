{
  "expo": {
    "name": "Foco a Dois",
    "slug": "foco-a-dois",
    "version": "1.0.0",
    "scheme": "focoadois",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "backgroundColor": "#101010",
    "primaryColor": "#6C63FF",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.focoadois.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "POST_NOTIFICATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.focoadois.app"
    },
    "plugins": [
      "expo-router",
      "./plugins/withReactNativeArchitectures",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_800ExtraBold.ttf",
            "./assets/fonts/ionicons.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#101010",
          "resizeMode": "contain"
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "O Foco a Dois usa o calendário para sincronizar as tarefas do casal."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
