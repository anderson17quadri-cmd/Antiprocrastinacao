rules_version = '2';

// Regras do Firestore — Foco a Dois.
//
// Estrutura: couples/{coupleId}/tasks/{taskId}
//            couples/{coupleId}/activity/{eventId}
//
// Cada casal só pode ler/escrever nos próprios documentos: o uid do
// usuário autenticado precisa constar em couples/{coupleId}.memberIds.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    match /couples/{coupleId} {
      // Criação: qualquer usuário autenticado pode criar o casal, desde
      // que se inclua como membro. Leitura/edição: só quem já é membro.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      allow read, update: if isCoupleMember(coupleId);
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /activity/{eventId} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }

    // Qualquer outro caminho: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
